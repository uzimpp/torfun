# Copy to .env and fill in real values. Never commit .env.

# --- apps/api ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Mongo Atlas connection string (use a local mongodb-atlas-local container
# for development — see docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/torfun

CORS_ORIGINS=http://localhost:3000

# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-2.0-flash
# Local dev only — path to a downloaded service-account key.
# Deployed environments should use Workload Identity Federation instead.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Notifications (USR-04/USR-05: matches notify by email only) ---
SMTP_URL=
# Leave unset (don't assign an empty string) unless you have a real address —
# it's validated as an email when present.
# NOTIFICATION_FROM_EMAIL=notifications@example.com

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8080
