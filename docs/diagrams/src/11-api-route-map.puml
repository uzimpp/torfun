@startuml 11-api-route-map
!pragma layout smetana
!include style.iuml
title API route map by access level (all paths under /api)
skinparam rectangleBackgroundColor #F2F6FC
skinparam rectangleBorderColor #4A6FA5
package "public" #E9F7EF {
  rectangle "Health\nGET /health" as p1
  rectangle "Auth\nPOST /auth/register  (201, throttled)\nPOST /auth/login  (throttled)\nPOST /auth/refresh  (cookie)\nPOST /auth/logout\nGET /auth/google\nGET /auth/google/callback" as p2
}
package "user  (requireAuth)" #EAF2FB {
  rectangle "Session\nGET /auth/me\nGET /dashboard (placeholder)" as u1
  rectangle "TORs  (officer sees tor_analysed only)\nGET /tors\nGET /tors/:projectId\nGET /tors/:projectId/source  (PDF, re-fetched)\nPOST /tors/:projectId/reports" as u2
  rectangle "My TOR\nGET /favorites\nGET /favorites/:projectId\nPOST /favorites\nDELETE /favorites/:projectId" as u3
  rectangle "Vendor record\nGET /companies/search\nPOST /companies\nGET, PATCH /companies/me\nPOST /companies/:id/join\nGET, POST /clients  GET /clients/suggestions\nPATCH, DELETE /clients/:id\nGET, POST /experiences\nPATCH, DELETE /experiences/:id" as u4
}
package "admin  (requireAdmin)" #FDF2E9 {
  rectangle "Accounts and reports\nGET /admin/users\nPATCH /admin/users/:id\nGET /admin/tor-reports\nPATCH /admin/tor-reports/:reportId\nGET /health/dependencies" as a1
  rectangle "Ingestion operations\nGET /ingestion/summary, /projects,\n  /projects/:projectId, /failures,\n  /ops, /recent\nPOST /ingestion/run   (202 or 409)\nPOST /ingestion/run/stop\nGET, PUT /ingestion/schedule" as a2
  rectangle "Moderation\nPOST /ingestion/procurements/:id/approve\nPOST .../non-software\nPOST .../read-anyway\nDELETE /ingestion/procurements/:id?allowReimport=\nGET /ingestion/tombstones\nDELETE /ingestion/tombstones/:id\nPOST /ingestion/tombstones/:id/restore" as a3
}
p1 -[hidden]-> u1
p2 -[hidden]-> u1
u1 -[hidden]-> a1
u2 -[hidden]-> a2
u3 -[hidden]-> a2
u4 -[hidden]-> a3
@enduml
