@startuml 05-refresh-flow
!include style.iuml
title Refresh of a project already read (Gate tier refresh)
start
if (detailReadAt is null?) then (yes)
  :Detail turn first - same Gate hold;
  if (Goods category in scope?) then (no)
    :outcome = out_of_scope;
    stop
  else (yes)
  endif
else (no)
endif
:Read timeline (greenBook);
if (data is null?) then (yes)
  :Keep what the record had\nlog "no timeline";
  stop
else (no)
endif
if (Status is drafting?) then (yes)
  :Read the comment deadline;
else (no)
endif
if (Invitation date moved?) then (no)
  :Save timeline if it changed,\notherwise only lastReadAt;
  :Done - no archive and no model call;
  stop
else (yes)
endif
if (Waiting-room place free RIGHT NOW?) then (no)
  :putBack at the end of the queue\nrecord left untouched;
  note right
    A refresh holds the Gate, so it never
    waits for a place: the room could be full
    of records waiting for this very Gate.
  end note
  stop
else (yes)
endif
:Look up zipId and download the archive;
:Analysis re-reads the INVITATION only;
:Replace invitation documents\nupdate timeline.deadlineAt;
stop
@enduml
