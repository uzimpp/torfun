@startuml 13-seq-admin-run
!include style.iuml
title API sequence - administrator starts, watches and stops a Run
autonumber
actor "Administrator" as Ad
participant "Web /admin/ingestion" as W
participant "API" as A
database "run_lease" as L
participant "Pipeline" as P
Ad -> W : Start run
W -> A : POST /api/ingestion/run
A -> L : acquire lease
alt a Run is already live
  A --> W : 409 Conflict
else lease acquired
  A -> P : startRun (not awaited)
  A --> W : 202 { started: true }
  loop every few seconds
    W -> A : GET /api/ingestion/ops
    A --> W : run state, live work, counts
  end
  Ad -> W : Stop
  W -> A : POST /api/ingestion/run/stop
  A --> W : 202 { stopping: true }
  P -> P : finish held archives,\nask e-GP for nothing new
  P -> L : release lease
end
@enduml
