@startuml 10-api-request-lifecycle
!include style.iuml
title API - how a request travels
start
:HTTP request;
:helmet headers, CORS allowlist,\nglobal rate limit 100 per minute per IP;
:Parse cookies, verify access JWT;
if (Route scope) then (public)
else (protected)
  if (Valid access token?) then (no)
    :401 Unauthorized;
    stop
  else (yes)
  endif
  if (Admin-only scope?) then (yes)
    if (role = admin?) then (no)
      :403 Forbidden;
      stop
    else (yes)
    endif
  else (no)
  endif
endif
:Validate params, query and body\nwith the route's zod schema;
if (Valid?) then (no)
  :400 with errors;
  stop
else (yes)
endif
:Route handler - calls exactly ONE service;
:Service - business rules, audience filter\nthrows typed errors (AppError);
:Repository - snake_case document <-> domain;
:MongoDB;
if (Service threw?) then (yes)
  :Error handler -> { message } + status\n(5xx is always "Internal server error");
  stop
else (no)
endif
:Serialise through the route's response schema;
:200 / 201 / 202 / 204;
stop
@enduml
