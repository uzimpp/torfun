# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Mongo Atlas connection string (use a local mongodb-atlas-local container
# for development — see docker-compose.yml).
MONGODB_URI=mongodb://localhost:27017/torfun

# Comma-separated allowlist of browser origins permitted to call this API.
CORS_ORIGINS=http://localhost:3000

# Where the browser is redirected after a successful Google sign-in.
WEB_APP_URL=http://localhost:3000/profile

# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Google OAuth 2.0 (user sign-in) ---
# Unrelated to the Google Cloud block below: these authenticate *users*, that
# authenticates *this server*. From Google Cloud console > APIs & Services >
# Credentials > Create OAuth client ID > Web application.
# No "Authorized JavaScript origin" is needed — @fastify/oauth2 uses the
# server-side authorization code flow, so no browser JS calls Google directly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must byte-for-byte match an "Authorized redirect URI" on that client, or
# Google returns redirect_uri_mismatch. Note it points at the API (8080), not
# the web app (3000). In production, use the api's own Cloud Run URL.
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# --- Google Cloud / Vertex AI ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_AI_MODEL=gemini-3.5-flash
# How this server authenticates to Google. Pick ONE, by where you are running:
#
#   Cloud Run      set NEITHER. The attached runtime service account is picked
#                  up automatically; setting either would override it.
#   bun run dev    set NEITHER, and run `gcloud auth application-default login`.
#                  Short-lived credentials, nothing to leak into the repo.
#   docker compose set GOOGLE_SERVICE_ACCOUNT_JSON. A container has no
#                  ~/.config/gcloud, so ADC cannot find your gcloud login.
#
# Path to a downloaded service-account key. ADC's own convention.
GOOGLE_APPLICATION_CREDENTIALS=
# The same key as a value instead of a path — raw JSON, or base64 of it:
#   base64 -i key.json | tr -d '\n'
# Takes precedence over ADC. A long-lived credential: keep it out of git, and
# prefer Secret Manager over a .env file for anything deployed.
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- e-GP ingestion (Thai government procurement) ---
# Open-data API key. Register at https://opend.data.go.th/register_api/
EGP_API_KEY=
# Per-run cap on retrievals against gprocurement.go.th, which asks not to be
# crawled. Keep this low.
EGP_MAX_DOWNLOADS_PER_RUN=15
