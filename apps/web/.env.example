# Copy to .env and fill in real values. Never commit .env.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time —
# never put a secret here.

# Where the *browser* reaches the API.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Where *server-side rendering* reaches the API, when that is a different
# address. Leave unset for `bun run dev` and anywhere the two halves share a
# network — it falls back to NEXT_PUBLIC_API_URL, which is then correct.
#
# Set it under Docker Compose, where SSR runs inside the web container and the
# published host port above is unreachable from there. `bun run docker:up`
# supplies it; see the `web` service in docker-compose.yml.
#
# Deliberately not NEXT_PUBLIC_: that prefix would make Next inline it at build
# time, which is exactly what stops the public variable from covering this case.
# INTERNAL_API_URL=http://api:8080
